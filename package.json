{
  "name": "pos-dashboard",
  "version": "1.0.0",
  "description": "POS Analytics Dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:uat": "cross-env ENV=UAT node server.js",
    "start:prod": "cross-env ENV=PROD node server.js",
    "dev:uat": "cross-env ENV=UAT nodemon server.js",
    "dev:prod": "cross-env ENV=PROD nodemon server.js",
    "test": "cross-env ENV=UAT node --test",
    "test:money": "cross-env ENV=TEST node --test --test-concurrency=1 test/money/**/*.test.js",
    "test:money:watch": "cross-env ENV=TEST node --test --watch --test-concurrency=1 test/money/**/*.test.js",
    "db:test:init": "cross-env ENV=TEST node scripts/init-test-db.js",
    "build:icons": "node scripts/build-icons.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "axios": "^1.18.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.21",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.5.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "lucide": "^1.30.0",
    "nodemon": "^3.0.2"
  }
}
